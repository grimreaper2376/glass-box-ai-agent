# GlassBox settings. Copy to .env or set these in your shell.
#
# There is deliberately NO Binance API key here. GlassBox never handles
# exchange credentials: authentication happens through the official Binance MCP
# server's OAuth flow inside your AI client, and there is no withdrawal scope.

# paper | shadow | bridge
GLASSBOX_MODE=paper

# 1 uses Binance's public market data endpoints (no auth, read-only)
GLASSBOX_LIVE_DATA=0

# Starting paper equity in USDT
GLASSBOX_EQUITY=10000

# Seconds between engine ticks
GLASSBOX_TICK=3.0

# Where the ledger and device key live
# GLASSBOX_HOME=/home/you/.glassbox

# Path to your rulebook
# GLASSBOX_POLICY=./constitution.yaml

# Optional. When set, analysts ask a model to critique their heuristic
# conclusion. The critique can lower confidence but never create a position
# from nothing.
# ANTHROPIC_API_KEY=

# --------------------------------------------------------------------------
# Analyst Desk — optional language-model brain (Council tab → "Ask the desk")
# --------------------------------------------------------------------------
# The desk works with NO key: it answers from real, computed data on its own.
# Set ONE of the keys below to make it a fully conversational analyst — the
# model receives the same grounded facts and is constrained to them, so it
# still cannot invent a number. GlassBox picks the first key it finds, in the
# order listed. The first two have free tiers.
#
#   Groq   — free, fast. Get a key at https://console.groq.com  (recommended)
# GROQ_API_KEY=
#   Google Gemini — free tier. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
#   OpenAI (paid)
# OPENAI_API_KEY=
#   OpenRouter (many models, some free)
# OPENROUTER_API_KEY=
#
# Optional: override the model name for whichever provider is active.
# GLASSBOX_LLM_MODEL=
